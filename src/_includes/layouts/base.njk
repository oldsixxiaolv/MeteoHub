{# ============================================================================
  base.njk · 全站骨架
  ----------------------------------------------------------------------------
  包含：HTML 头、字体外链、CSS 串接、theme 早期注入（避免 FOUC）、
        skip-link、topbar（partial）、main slot、footer（partial）、
        主脚本（theme + nav + main）、Person JSON-LD（全站学术画像）。
  ========================================================================== #}
<!DOCTYPE html>
<html lang="{{ site.locale or 'zh-CN' }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ description or site.description }}" />
  <title>{% if title %}{{ title }} · {{ site.shortTitle }}{% else %}{{ site.title }}{% endif %}</title>

  {# —— 字体外链（preconnect + preload + stylesheet） ——
       关键路径只留 3 个 Latin 字族（合计 19.9KB）：nav / UI / 首页大标题 /
       代码块都是 Latin，首屏立刻要用。
       Noto Serif SC 拆出去异步加载：光这一个字族的 Google Fonts CSS 就有 339KB
       （303 个 @font-face，CJK 按 unicode-range 切成上百个子集），占全站字体
       CSS 的 94.5%。挂在阻塞 stylesheet 上等于首屏先白等 339KB 才出字形。
       tokens.css 已为它备好 'Noto Serif SC Fallback'（size-adjust 105% +
       ascent/descent override，走本地 Songti SC），首屏先用系统衬线中文渲染，
       metrics 对齐后换 webfont 几乎看不出抖动 —— 与下面 components/layout/pages
       用的是同一套异步加载，行为一致。
       JetBrains Mono 故意留在关键路径：它的 CSS 只有 5KB，且代码块和页眉小标签
       首屏就要用到，拆出去只多一个请求、换不到什么字节。 —— #}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload" as="style"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:wght@400;600&family=JetBrains+Mono:wght@400;500&display=swap"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:wght@400;600&family=JetBrains+Mono:wght@400;500&display=swap"
  />
  <link
    rel="preload" as="style"
    href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;700&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;700&display=swap" />
  </noscript>

  {# —— Critical CSS：tokens + base 内联（first paint 即用，省一次 round trip） —— #}
  {% inlineCss "src/assets/css/tokens.css" %}
  {% inlineCss "src/assets/css/base.css" %}

  {# —— Non-critical CSS：components / layout / pages 异步加载
     preload + onload swap + <noscript> 同步 fallback —— #}
  <link rel="preload" as="style" href="{{ '/assets/css/components.css' | url }}" onload="this.onload=null;this.rel='stylesheet'" />
  <link rel="preload" as="style" href="{{ '/assets/css/layout.css' | url }}" onload="this.onload=null;this.rel='stylesheet'" />
  <link rel="preload" as="style" href="{{ '/assets/css/pages.css' | url }}" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript>
    <link rel="stylesheet" href="{{ '/assets/css/components.css' | url }}" />
    <link rel="stylesheet" href="{{ '/assets/css/layout.css' | url }}" />
    <link rel="stylesheet" href="{{ '/assets/css/pages.css' | url }}" />
  </noscript>

  {# —— a11y.css (Phase 2A.3)：与其余非关键 CSS 一起异步加载 ——
       注意它"必须最后生效"这件事并不依赖 link 标签的书写顺序（4 个 preload
       并行下载，落到 cascade 的先后是不确定的），真正的保障有两条：
         1. a11y.css 是全站唯一使用 !important 的样式表，它的覆盖规则不会
            被 components/layout/pages 的普通声明反超（base.css 里那段
            prefers-reduced-motion 与它重复且内容相同，不构成冲突）；
         2. 剩下的 :root 自定义属性覆盖（prefers-contrast / forced-colors 两块）
            只能和 tokens.css 竞争，而 tokens.css 是内联在 head 更靠前的 <style>，
            异步样式表总是追加到 head 末尾，永远排在其后。
       所以把它放最后只是保持可读性，真正让它安全的是上面两条。 —— #}
  <link rel="preload" as="style" href="{{ '/assets/css/a11y.css' | url }}" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript>
    <link rel="stylesheet" href="{{ '/assets/css/a11y.css' | url }}" />
  </noscript>

  {% block extraHead %}{% endblock %}

  {# —— Favicon —— #}
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}" />

  {# —— canonical link（GH Pages 子路径下由 pathPrefix 自动处理 page.url） —— #}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  {# 备用 hreflang：主站点是中英混排，当前只声明默认 locale，避免误判多语言版本 #}
  <link rel="alternate" hreflang="{{ site.locale or 'zh-CN' }}" href="{{ site.url }}{{ page.url }}" />
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url }}" />

  {# =====================================================================
       Open Graph（所有页必备；paper 页可设置 front-matter `cover: "/path/to/img"` 覆盖）
       ===================================================================== #}
  {% set ogTitle = title or site.title %}
  {% set ogDesc = description or site.description %}

  <meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}" />
  <meta property="og:site_name" content="{{ site.title }}" />
  <meta property="og:title" content="{{ ogTitle }}" />
  <meta property="og:description" content="{{ ogDesc }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:locale" content="{{ site.locale or 'zh_CN' }}" />

  {# ---------------------------------------------------------------------
       og:image override 机制（Phase 2B.1）：
         · 默认 → 全站统一的三尺寸静态图（UI/UX Pro Max 设计 · Phase 1.3）
         · 覆盖 → 当 front-matter `cover` 存在时，单图替换三尺寸
                  （论文页用 paper-specific 封面；保持社交平台覆盖简单可预测）
       --------------------------------------------------------------------- #}
  {% if cover %}
    {# 绝对 URL (http/https) 原样保留；相对路径 → 拼 site.url + 路径。
       site.url 是 https://oldsixxiaolv.github.io/MeteoHub（无尾斜杠），
       cover 通常是 "/content/papers/.../cover.svg"（带前导斜杠），自然拼成完整 URL。
       没有前导斜杠的话强制补一个避免 MeteoHubcover.svg 这种拼接。 #}
    {% if cover.startsWith('http') %}
      {% set coverUrl = cover %}
    {% elif cover.startsWith('/') %}
      {% set coverUrl = site.url + cover %}
    {% else %}
      {% set coverUrl = site.url + '/' + cover %}
    {% endif %}
    <meta property="og:image" content="{{ coverUrl }}" />
    <meta property="og:image:secure_url" content="{{ coverUrl }}" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="{{ ogTitle }} · {{ site.author.name }}, {{ site.author.jobTitle }}" />
  {% else %}
    {# 多尺寸 og:image（默认 fallback；社交平台按 slot 尺寸自动选图）：
         1. 1200×630  — FB / LinkedIn / Twitter summary_large_image 默认
         2. 1080×1080 — Twitter / Instagram / IG Story 正方形
         3. 1500×500  — X header-like 横幅
         所有图在 src/assets/img/og/ 下（SVG 源 + PNG 导出）。
    #}
    <meta property="og:image" content="{{ site.url }}/assets/img/og/og-1200x630.png" />
    <meta property="og:image:secure_url" content="{{ site.url }}/assets/img/og/og-1200x630.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ ogTitle }} · {{ site.author.name }}, {{ site.author.jobTitle }}" />

    <meta property="og:image" content="{{ site.url }}/assets/img/og/og-1080x1080.png" />
    <meta property="og:image:secure_url" content="{{ site.url }}/assets/img/og/og-1080x1080.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1080" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content="{{ ogTitle }} · {{ site.author.name }}, {{ site.author.jobTitle }} (square)" />

    <meta property="og:image" content="{{ site.url }}/assets/img/og/og-1500x500.png" />
    <meta property="og:image:secure_url" content="{{ site.url }}/assets/img/og/og-1500x500.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1500" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:alt" content="{{ ogTitle }} · {{ site.author.name }}, {{ site.author.jobTitle }} (wide)" />
  {% endif %}

  {# =====================================================================
       Twitter Card（summary_large_image：需要 1200×630 以上的图片）
       · 默认 → 1200×630 静态 PNG
       · 覆盖 → 当 front-matter `cover` 存在时，替换为 cover（与 og:image 同步）
       ===================================================================== #}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ ogTitle }}" />
  <meta name="twitter:description" content="{{ ogDesc }}" />
  {% if cover %}
    {% if cover.startsWith('http') %}
      {% set twitterCoverUrl = cover %}
    {% elif cover.startsWith('/') %}
      {% set twitterCoverUrl = site.url + cover %}
    {% else %}
      {% set twitterCoverUrl = site.url + '/' + cover %}
    {% endif %}
    <meta name="twitter:image" content="{{ twitterCoverUrl }}" />
    <meta name="twitter:image:alt" content="{{ ogTitle }} · {{ site.author.name }}, {{ site.author.jobTitle }}" />
  {% else %}
    <meta name="twitter:image" content="{{ site.url }}/assets/img/og/og-1200x630.png" />
    <meta name="twitter:image:alt" content="{{ ogTitle }} · {{ site.author.name }}, {{ site.author.jobTitle }}" />
  {% endif %}
  <meta name="twitter:site" content="{{ site.author.twitterSite or '@meteohub' }}" />
  <meta name="twitter:creator" content="{{ site.author.twitterCreator or '@oldsixxiaolv' }}" />

  {# =====================================================================
       Person JSON-LD（全站学术画像 · Google 知识图谱）
       sameAs / knowsAbout 由 site.author 提供（详见 src/_data/site.js）
       ===================================================================== #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ site.author.name }}",
    "alternateName": "{{ site.author.alternateName or site.author.fullName or '' }}",
    "givenName": "{{ site.author.givenName or '' }}",
    "familyName": "{{ site.author.familyName or '' }}",
    "jobTitle": "{{ site.author.jobTitle or site.author.role }}",
    "description": "{{ site.author.bio or site.author.research }}",
    "url": "{{ site.url }}{{ page.url }}",
    "sameAs": {{ site.author.sameAs | dump | safe }},
    "knowsAbout": {{ site.author.knowsAbout | dump | safe }},
    "affiliation": {
      "@type": "Organization",
      "name": "{{ site.author.affiliation }}",
      "url": "{{ site.author.affiliationUrl or '' }}"
    },
    "email": "{{ site.author.email or '' }}",
    "workLocation": {
      "@type": "Place",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Beijing",
        "addressCountry": "CN"
      }
    }
  }
  </script>

  {% block structuredData %}{% endblock %}

  {# —— 主题早期注入：避免主题闪烁（FOUC）—— #}
  <script>
    (function () {
      try {
        var saved = localStorage.getItem("meteohub-theme");
        var sys = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        var t = saved || sys;
        if (t === "dark") document.documentElement.setAttribute("data-theme", "dark");
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">跳到正文</a>

  {% include "partials/header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  {# —— 主脚本：theme + nav + reading progress —— #}
  <script type="module" src="{{ '/assets/js/main.js' | url }}"></script>
</body>
</html>