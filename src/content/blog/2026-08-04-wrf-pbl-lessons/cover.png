<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="800" height="450">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0f1d2c"/>
      <stop offset="1" stop-color="#1a3a52"/>
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#sky)"/>
  <g font-family="Inter, sans-serif">
    <text x="40" y="60" font-size="22" font-weight="600" fill="#ffd166">WRF · PBL 方案对比</text>
    <text x="40" y="86" font-size="14" fill="#cfd8dc">YSU / MYJ / MYNN2.5 / Shin-Hong</text>
  </g>
  <g transform="translate(60 130)" font-family="JetBrains Mono, monospace" font-size="12" fill="#9bd1ff">
    <line x1="0" y1="0" x2="600" y2="0" stroke="#7ec0ee" stroke-width="0.6"/>
    <g>
      <rect x="0"   y="10" width="80" height="80" fill="#ef476f" opacity="0.7"/>
      <rect x="120" y="40" width="80" height="50" fill="#ffd166" opacity="0.7"/>
      <rect x="240" y="20" width="80" height="70" fill="#06d6a0" opacity="0.7"/>
      <rect x="360" y="60" width="80" height="30" fill="#118ab2" opacity="0.7"/>
    </g>
    <text x="0"   y="115">YSU</text>
    <text x="120" y="115">MYJ</text>
    <text x="240" y="115">MYNN2.5</text>
    <text x="360" y="115">Shin-Hong</text>
    <text x="0" y="160" fill="#cfd8dc">★ MYNN2.5 + Thompson + Noah-MP 整体偏差最小</text>
    <text x="0" y="180" fill="#cfd8dc">★ 网格尺度 → 决定 PBL 方案是否适用</text>
    <text x="0" y="200" fill="#cfd8dc">★ PBL ↔ 陆面 ↔ 地表层 必须配套</text>
  </g>
</svg>
