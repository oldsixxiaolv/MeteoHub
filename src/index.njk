        <a class="btn btn--primary" href="{{ '/papers/' | url }}">Explore paper notes <span aria-hidden="true">↗</span></a>
        <a class="btn btn--outline" href="{{ '/portfolio/' | url }}">View research projects</a>
      </div>
      {# ⚠️ Phase 2B.1：persona 单一来源 = site.author.jobTitle，不要再硬编码
         "PhD Candidate" / "Postdoctoral researcher" / "博士后" 等字符串。
         如要修改学术身份，改 src/_data/site.js → author.jobTitle 即可。 #}
      <p class="home-hero__micro">{{ site.author.jobTitle }} · {{ site.author.affiliation }}</p>
