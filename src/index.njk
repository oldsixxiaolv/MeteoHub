  <section class="home-latest" data-reveal>
    <div class="home-section-head"><div><p class="home-eyebrow">LATEST SIGNALS</p><h2>Recently collected</h2></div><a href="{{ '/blog/' | url }}">All notes <span aria-hidden="true">→</span></a></div>
    <div class="home-latest__grid">
      <div><p class="home-latest__label">Notes</p><ul class="list">{% for post in collections.blog | head(3) %}<li class="list__item"><a class="list__title" href="{{ post.url | url }}">{{ post.data.title }}</a><p class="list__meta"><time datetime="{{ post.date | date('yyyy-LL-dd') }}">{{ post.date | date('yyyy-MM-dd') }}</time></p></li>{% endfor %}</ul></div>
      {# 状态字段名跟 paper.njk 对齐用 readingStatus：写 status 的话
         holton（只有 readingStatus）会渲染出空的 "1987 · "，
         microphysics（只有 status: published）会漏出未翻译的英文。 #}
      <div><p class="home-latest__label">Papers</p><ul class="list">{% for paper in collections.papers | head(3) %}<li class="list__item"><a class="list__title" href="{{ paper.url | url }}">{{ paper.data.title }}</a><p class="list__meta">{% if paper.data.year %}{{ paper.data.year }}{% endif %}{% if paper.data.readingStatus %} · {{ paper.data.readingStatus | statusLabel }}{% endif %}</p></li>{% endfor %}</ul></div>
    </div>
  </section>
