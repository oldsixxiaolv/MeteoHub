---
pagination:
  data: collections.portfolio
  size: 100
  alias: projects
permalink: "/portfolio/"
layout: layouts/page.njk
eleventyNavigation:
  key: Portfolio
  order: 2
---

<article class="list-page">
  <header class="list-page__head">
    <h1>作品集</h1>
    <p class="list-page__lede">研究项目与工程实践，按年份倒序。</p>
  </header>

  <ul class="list">
    {% for project in projects %}
      <li class="list__item">
        {# | url 不能省：Eleventy v3 的 pathPrefix 只在 url filter 里生效，
           collection item 的 .url 永远是站点根相对的裸路径。 #}
        <a class="list__title" href="{{ project.url | url }}">{{ project.data.title }}</a>
        <p class="list__meta">
          {% if project.data.type %}<span>{{ project.data.type }}</span> · {% endif %}
          <span>{{ project.data.year }}</span>
          {% if project.data.stack %}<span> · {{ project.data.stack | join(', ') }}</span>{% endif %}
        </p>
      </li>
    {% endfor %}
  </ul>
</article>